{
  "name": "orbit-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/orbit-core/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "tsc -p tsconfig.build.json", "cwd": "packages/orbit-core" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "tsc --noEmit", "cwd": "packages/orbit-core" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "eslint src --max-warnings 0", "cwd": "packages/orbit-core" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "vitest run", "cwd": "packages/orbit-core" }
    }
  }
}
