{
  "name": "patient-model-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/patient-model-service/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc -p tsconfig.build.json",
        "cwd": "services/patient-model-service"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/services/test-support/**/*.ts"],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "services/patient-model-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/services/test-support/**/*.ts"
      ],
      "options": {
        "command": "eslint src test ../test-support --max-warnings 0",
        "cwd": "services/patient-model-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/services/test-support/**/*.ts",
        { "env": "RUN_INTEGRATION_TESTS" }
      ],
      "options": {
        "command": "vitest run",
        "cwd": "services/patient-model-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch src/main.ts",
        "cwd": "services/patient-model-service"
      }
    }
  }
}
